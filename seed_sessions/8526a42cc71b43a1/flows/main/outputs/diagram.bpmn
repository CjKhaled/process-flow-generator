<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_enrollment_and_intake" targetNamespace="http://process-flow-generator/bpmn">
  <bpmn:collaboration id="Collaboration_enrollment_and_intake">
    <bpmn:participant id="Participant_enrollment_and_intake" name="Intake &amp; Enrollment" processRef="Process_enrollment_and_intake" />
  </bpmn:collaboration>
  <bpmn:process id="Process_enrollment_and_intake" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_enrollment_and_intake">
      <bpmn:lane id="Lane_Meridian" name="Meridian">
        <bpmn:flowNodeRef>Node_receive_enrollment_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_key_pef_into_atlas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_gw_patient_exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_sub_duplicate_handling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_check_diagnosis_code</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_gw_off_label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_sub_off_label_review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PAM" name="PAM">
        <bpmn:flowNodeRef>Node_gw_missing_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_sub_missing_info_hcp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_gw_hipaa_signed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_follow_up_docusign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_move_to_bv</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Atlas" name="Atlas">
        <bpmn:flowNodeRef>Node_create_assign_case</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_receive_enrollment_form" name="Receive enrollment form" />
    <bpmn:task id="Node_key_pef_into_atlas" name="Key PEF into Atlas" />
    <bpmn:exclusiveGateway id="Node_gw_patient_exists" name="Patient already in system?" />
    <bpmn:subProcess id="Node_sub_duplicate_handling" name="Duplicate handling" />
    <bpmn:task id="Node_check_diagnosis_code" name="Check diagnosis code against approved codes" />
    <bpmn:exclusiveGateway id="Node_gw_off_label" name="Is it off-label?" />
    <bpmn:subProcess id="Node_sub_off_label_review" name="Off-label review" />
    <bpmn:exclusiveGateway id="Node_gw_missing_info" name="Anything missing from the form?" />
    <bpmn:subProcess id="Node_sub_missing_info_hcp" name="Missing information outreach (HCP)" />
    <bpmn:exclusiveGateway id="Node_gw_hipaa_signed" name="HIPAA section signed?" />
    <bpmn:task id="Node_follow_up_docusign" name="Follow up and send DocuSign link" />
    <bpmn:task id="Node_create_assign_case" name="Create case and assign by territory" />
    <bpmn:endEvent id="Node_move_to_bv" name="Patient moves on to BV" />
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Node_receive_enrollment_form" targetRef="Node_key_pef_into_atlas" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Node_key_pef_into_atlas" targetRef="Node_gw_patient_exists" />
    <bpmn:sequenceFlow id="Flow_2" name="Yes" sourceRef="Node_gw_patient_exists" targetRef="Node_sub_duplicate_handling" />
    <bpmn:sequenceFlow id="Flow_3" name="No" sourceRef="Node_gw_patient_exists" targetRef="Node_check_diagnosis_code" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Node_check_diagnosis_code" targetRef="Node_gw_off_label" />
    <bpmn:sequenceFlow id="Flow_6" name="Yes" sourceRef="Node_gw_off_label" targetRef="Node_sub_off_label_review" />
    <bpmn:sequenceFlow id="Flow_7" name="No" sourceRef="Node_gw_off_label" targetRef="Node_gw_missing_info" />
    <bpmn:sequenceFlow id="Flow_8" name="Yes" sourceRef="Node_gw_missing_info" targetRef="Node_sub_missing_info_hcp" />
    <bpmn:sequenceFlow id="Flow_9" name="No" sourceRef="Node_gw_missing_info" targetRef="Node_gw_hipaa_signed" />
    <bpmn:sequenceFlow id="Flow_13" name="No" sourceRef="Node_gw_hipaa_signed" targetRef="Node_follow_up_docusign" />
    <bpmn:sequenceFlow id="Flow_14" name="Yes" sourceRef="Node_gw_hipaa_signed" targetRef="Node_create_assign_case" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Node_follow_up_docusign" targetRef="Node_gw_hipaa_signed" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Node_create_assign_case" targetRef="Node_move_to_bv" />
    <bpmn:textAnnotation id="Note_prescription_required_rule">
      <bpmn:text>Prescription must be part of submission</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_age_eligibility_rule">
      <bpmn:text>Program does not enroll any patients under 18</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_capture_consent_rule">
      <bpmn:text>Capture text and email consent</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_11" associationDirection="None" sourceRef="Node_check_diagnosis_code" targetRef="Note_age_eligibility_rule" />
    <bpmn:association id="Association_12" associationDirection="None" sourceRef="Node_create_assign_case" targetRef="Note_capture_consent_rule" />
    <bpmn:association id="Association_16" associationDirection="None" sourceRef="Node_key_pef_into_atlas" targetRef="Note_prescription_required_rule" />
  </bpmn:process>
