      <bpmndi:BPMNShape id="BPMNShape_Participant_enrollment_and_intake_duplicate_handling" bpmnElement="Participant_enrollment_and_intake_duplicate_handling" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="482" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Lane_Meridian" bpmnElement="Lane_Meridian" isHorizontal="true">
        <dc:Bounds x="110" y="80" width="452" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Node_slice_start" bpmnElement="Node_slice_start" color:background-color="#E3F3E7" color:border-color="#1A1628">
        <dc:Bounds x="128" y="180" width="80" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="129" y="223" width="78" height="70" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Node_handle_duplicate" bpmnElement="Node_handle_duplicate">
        <dc:Bounds x="286" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Node_slice_exit_check_diagnosis_code" bpmnElement="Node_slice_exit_check_diagnosis_code" color:background-color="#E3F3E7" color:border-color="#1A1628">
        <dc:Bounds x="464" y="180" width="80" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="462" y="323" width="85" height="98" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_0" bpmnElement="Flow_0">
