<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_enrollment" targetNamespace="http://process-flow-generator/bpmn">
  <bpmn:collaboration id="Collaboration_enrollment">
    <bpmn:participant id="Participant_enrollment" name="Intake &#38; Enrollment" processRef="Process_enrollment" />
  </bpmn:collaboration>
  <bpmn:process id="Process_enrollment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_enrollment">
      <bpmn:lane id="Lane_HCP" name="HCP">
        <bpmn:flowNodeRef>Node_start_pef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_term_hcp_sp_biologics</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CM360" name="CM360">
        <bpmn:flowNodeRef>Node_transcribe_pef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_send_fax_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_create_enrollment_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_gw_off_label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_gw_age_and_code</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_term_off_label_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_send_off_label_fax</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_gw_duplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_determine_existing_type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_term_existing_handled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_create_patient_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_create_bi_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_send_status_qral</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PSM" name="PSM">
        <bpmn:flowNodeRef>Node_confirm_diagnosis_code</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_gw_believes_on_label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_tell_prescriber_on_label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_gw_prescriber_agrees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_gw_test_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_contact_hcp_insist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_gw_doctor_insists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_term_enrolled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QRAL" name="QRAL">
        <bpmn:flowNodeRef>Node_qral_send_jcrm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_JCRM" name="JCRM">
        <bpmn:flowNodeRef>Node_create_onboarding_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_assign_psm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_start_pef" name="Complete PEF" />
    <bpmn:task id="Node_transcribe_pef" name="Transcribe PEF into CRM" />
    <bpmn:task id="Node_send_fax_confirmation" name="Send PEF fax confirmation to HCP" />
    <bpmn:task id="Node_create_enrollment_record" name="Create enrollment record" />
    <bpmn:exclusiveGateway id="Node_gw_off_label" name="Is diagnosis code off-label?" />
    <bpmn:exclusiveGateway id="Node_gw_age_and_code" name="Patient 18+ AND diagnosis code in document?" />
    <bpmn:task id="Node_confirm_diagnosis_code" name="Contact prescribing officer and confirm diagnosis code" />
    <bpmn:exclusiveGateway id="Node_gw_believes_on_label" name="HCP believes patient has unconfirmed on-label condition?" />
    <bpmn:task id="Node_tell_prescriber_on_label" name="Advise prescriber to select on-label code; offer free post-rx genetic testing" />
    <bpmn:exclusiveGateway id="Node_gw_prescriber_agrees" name="Prescriber agrees?" />
    <bpmn:exclusiveGateway id="Node_gw_test_result" name="Did free test disprove on-label diagnosis?" />
    <bpmn:task id="Node_contact_hcp_insist" name="Contact HCP about clinical judgement" />
    <bpmn:exclusiveGateway id="Node_gw_doctor_insists" name="Doctor insists on clinical judgement?" />
    <bpmn:endEvent id="Node_term_off_label_record" name="Patient off-label: not entered or archived" />
    <bpmn:task id="Node_send_off_label_fax" name="Send off-label notification fax to HCP office" />
    <bpmn:endEvent id="Node_term_hcp_sp_biologics" name="HCP works directly with SP Biologics" />
    <bpmn:exclusiveGateway id="Node_gw_duplicate" name="Does patient already exist?" />
    <bpmn:task id="Node_determine_existing_type" name="Determine re-enrollment, restart, or care plan update" />
    <bpmn:endEvent id="Node_term_existing_handled" name="Existing patient handling determined" />
    <bpmn:task id="Node_create_patient_record" name="Create patient record and associate with care plan" />
    <bpmn:task id="Node_create_bi_case" name="Create BI case" />
    <bpmn:task id="Node_send_status_qral" name="Send status to QRAL" />
    <bpmn:task id="Node_qral_send_jcrm" name="Send status to JCRM" />
    <bpmn:task id="Node_create_onboarding_case" name="Create onboarding case" />
    <bpmn:task id="Node_assign_psm" name="Assign PSM via zip to territory mapping" />
    <bpmn:endEvent id="Node_term_enrolled" name="Patient onboarded" />
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Node_start_pef" targetRef="Node_transcribe_pef" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Node_transcribe_pef" targetRef="Node_send_fax_confirmation" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Node_send_fax_confirmation" targetRef="Node_create_enrollment_record" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Node_create_enrollment_record" targetRef="Node_gw_off_label" />
    <bpmn:sequenceFlow id="Flow_4" name="Diagnosis code is off-label" sourceRef="Node_gw_off_label" targetRef="Node_gw_age_and_code" />
    <bpmn:sequenceFlow id="Flow_5" name="Diagnosis code is not off-label" sourceRef="Node_gw_off_label" targetRef="Node_gw_duplicate" />
    <bpmn:sequenceFlow id="Flow_6" name="Patient is 18 or older AND diagnosis code equals the ones in their document" sourceRef="Node_gw_age_and_code" targetRef="Node_confirm_diagnosis_code" />
    <bpmn:sequenceFlow id="Flow_7" name="Otherwise (they are off-label)" sourceRef="Node_gw_age_and_code" targetRef="Node_term_off_label_record" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Node_confirm_diagnosis_code" targetRef="Node_gw_believes_on_label" />
    <bpmn:sequenceFlow id="Flow_9" name="HCP believes patient has an on-label condition not yet confirmed through genetic testing" sourceRef="Node_gw_believes_on_label" targetRef="Node_tell_prescriber_on_label" />
    <bpmn:sequenceFlow id="Flow_10" name="HCP does not indicate an unconfirmed on-label condition" sourceRef="Node_gw_believes_on_label" targetRef="Node_term_off_label_record" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Node_tell_prescriber_on_label" targetRef="Node_gw_prescriber_agrees" />
    <bpmn:sequenceFlow id="Flow_12" name="Prescriber agrees (patient proceeds with enrollment)" sourceRef="Node_gw_prescriber_agrees" targetRef="Node_gw_duplicate" />
    <bpmn:sequenceFlow id="Flow_13" name="Prescriber does not agree / after free post-rx testing" sourceRef="Node_gw_prescriber_agrees" targetRef="Node_gw_test_result" />
    <bpmn:sequenceFlow id="Flow_14" name="Free test disproved the on-label diagnosis" sourceRef="Node_gw_test_result" targetRef="Node_contact_hcp_insist" />
    <bpmn:sequenceFlow id="Flow_15" name="Free test confirmed the on-label diagnosis (outcome not stated)" sourceRef="Node_gw_test_result" targetRef="Node_gw_duplicate" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Node_contact_hcp_insist" targetRef="Node_gw_doctor_insists" />
    <bpmn:sequenceFlow id="Flow_17" name="Doctor insists on clinical judgement (patient continues as normal)" sourceRef="Node_gw_doctor_insists" targetRef="Node_gw_duplicate" />
    <bpmn:sequenceFlow id="Flow_18" name="Doctor does not insist (patient officially off-label)" sourceRef="Node_gw_doctor_insists" targetRef="Node_term_off_label_record" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Node_term_off_label_record" targetRef="Node_send_off_label_fax" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Node_send_off_label_fax" targetRef="Node_term_hcp_sp_biologics" />
    <bpmn:sequenceFlow id="Flow_21" name="Patient already exists" sourceRef="Node_gw_duplicate" targetRef="Node_determine_existing_type" />
    <bpmn:sequenceFlow id="Flow_22" name="New patient" sourceRef="Node_gw_duplicate" targetRef="Node_create_patient_record" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Node_determine_existing_type" targetRef="Node_term_existing_handled" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Node_create_patient_record" targetRef="Node_create_bi_case" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Node_create_bi_case" targetRef="Node_send_status_qral" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Node_send_status_qral" targetRef="Node_qral_send_jcrm" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Node_qral_send_jcrm" targetRef="Node_create_onboarding_case" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Node_create_onboarding_case" targetRef="Node_assign_psm" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Node_assign_psm" targetRef="Node_term_enrolled" />
    <bpmn:textAnnotation id="Node_anno_bi_status">
      <bpmn:text>Status: PENDING; Substatus: NEW PATIENT – HUB ENROLLED</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_25" associationDirection="None" sourceRef="Node_create_bi_case" targetRef="Node_anno_bi_status" />
  </bpmn:process>
