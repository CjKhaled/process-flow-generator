<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_enrollment" targetNamespace="http://process-flow-generator/bpmn">
  <bpmn:collaboration id="Collaboration_enrollment">
    <bpmn:participant id="Participant_enrollment" name="Intake &amp; Enrollment" processRef="Process_enrollment" />
  </bpmn:collaboration>
  <bpmn:process id="Process_enrollment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_enrollment">
      <bpmn:lane id="Lane_HCP" name="HCP">
        <bpmn:flowNodeRef>Node_start_pef</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CM360" name="CM360">
        <bpmn:flowNodeRef>Node_transcribe_pef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_send_fax_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_create_enrollment_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_gw_off_label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_sub_off_label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_gw_duplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_sub_duplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_create_patient_record</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_create_bi_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_sub_cm360_missing_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_cm360_send_activated_milestone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_create_careplan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PSM" name="PSM">
        <bpmn:flowNodeRef>Node_sub_psm_missing_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_welcome_tasks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_term_enrolled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QRAL" name="QRAL">
        <bpmn:flowNodeRef>Node_send_status_qral</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PSCRM" name="PSCRM">
        <bpmn:flowNodeRef>Node_create_onboarding_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_assign_psm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_gw_missing_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_create_collect_mi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_trigger_bi_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_close_collect_mi</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_start_pef" name="HCP completes PEF via portal or fax" />
    <bpmn:task id="Node_transcribe_pef" name="Transcribe PEF into CRM" />
    <bpmn:task id="Node_send_fax_confirmation" name="Send PEF fax confirmation to HCP" />
    <bpmn:task id="Node_create_enrollment_record" name="Create enrollment record in CM360" />
    <bpmn:exclusiveGateway id="Node_gw_off_label" name="Is diagnosis code off-label?" />
    <bpmn:subProcess id="Node_sub_off_label" name="Off-Label Review" />
    <bpmn:exclusiveGateway id="Node_gw_duplicate" name="Does the patient already exist?" />
    <bpmn:subProcess id="Node_sub_duplicate" name="Duplicate Handling" />
    <bpmn:task id="Node_create_patient_record" name="Create patient record and associate with care plan" />
    <bpmn:task id="Node_create_bi_case" name="Create BI case" />
    <bpmn:task id="Node_send_status_qral" name="Send status to QRAL, QRAL sends to JCRM" />
    <bpmn:task id="Node_create_onboarding_case" name="Automatically create onboarding case" />
    <bpmn:task id="Node_assign_psm" name="Assign PSM via zip to territory mapping" />
    <bpmn:exclusiveGateway id="Node_gw_missing_info" name="Is there missing info (sections 1, 2, 5, or 6)?" />
    <bpmn:task id="Node_create_collect_mi" name="Automatically create 'Collect MI' task" />
    <bpmn:subProcess id="Node_sub_cm360_missing_info" name="CM360 Missing Info" />
    <bpmn:subProcess id="Node_sub_psm_missing_info" name="PSM Missing Info" />
    <bpmn:task id="Node_cm360_send_activated_milestone" name="Send patient data &amp; activated coverage determination milestone to QRAL" />
    <bpmn:task id="Node_trigger_bi_case" name="Create BI case with Confirm Benefits Details and Additional Info tasks" />
    <bpmn:task id="Node_close_collect_mi" name="Agent manually closes 'Collect MI' task" />
    <bpmn:task id="Node_welcome_tasks" name="Create and manually close 'Make Welcome Call' and 'Send Welcome Materials' tasks" />
    <bpmn:task id="Node_create_careplan" name="Create care plan with onboarding &amp; coverage determination milestones activated" />
    <bpmn:endEvent id="Node_term_enrolled" name="Patient enrolled" />
    <bpmn:sequenceFlow id="Flow_0" sourceRef="Node_start_pef" targetRef="Node_transcribe_pef" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Node_transcribe_pef" targetRef="Node_send_fax_confirmation" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Node_send_fax_confirmation" targetRef="Node_create_enrollment_record" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Node_create_enrollment_record" targetRef="Node_gw_off_label" />
    <bpmn:sequenceFlow id="Flow_4" name="Yes" sourceRef="Node_gw_off_label" targetRef="Node_sub_off_label" />
    <bpmn:sequenceFlow id="Flow_5" name="No" sourceRef="Node_gw_off_label" targetRef="Node_gw_duplicate" />
    <bpmn:sequenceFlow id="Flow_20" name="Yes" sourceRef="Node_gw_duplicate" targetRef="Node_sub_duplicate" />
    <bpmn:sequenceFlow id="Flow_21" name="No" sourceRef="Node_gw_duplicate" targetRef="Node_create_patient_record" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Node_create_patient_record" targetRef="Node_create_bi_case" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Node_create_bi_case" targetRef="Node_send_status_qral" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Node_send_status_qral" targetRef="Node_create_onboarding_case" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Node_create_onboarding_case" targetRef="Node_assign_psm" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Node_assign_psm" targetRef="Node_gw_missing_info" />
    <bpmn:sequenceFlow id="Flow_29" name="Yes" sourceRef="Node_gw_missing_info" targetRef="Node_create_collect_mi" />
    <bpmn:sequenceFlow id="Flow_30" name="No" sourceRef="Node_gw_missing_info" targetRef="Node_cm360_send_activated_milestone" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Node_create_collect_mi" targetRef="Node_sub_cm360_missing_info" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Node_sub_cm360_missing_info" targetRef="Node_sub_psm_missing_info" />
    <bpmn:sequenceFlow id="Flow_66" sourceRef="Node_cm360_send_activated_milestone" targetRef="Node_trigger_bi_case" />
    <bpmn:sequenceFlow id="Flow_67" sourceRef="Node_trigger_bi_case" targetRef="Node_close_collect_mi" />
    <bpmn:sequenceFlow id="Flow_68" sourceRef="Node_close_collect_mi" targetRef="Node_welcome_tasks" />
    <bpmn:sequenceFlow id="Flow_69" sourceRef="Node_welcome_tasks" targetRef="Node_create_careplan" />
    <bpmn:sequenceFlow id="Flow_70" sourceRef="Node_create_careplan" targetRef="Node_term_enrolled" />
    <bpmn:textAnnotation id="Note_anno_bi_status">
      <bpmn:text>Status: PENDING, Substatus: NEW PATIENT – HUB ENROLLED</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_24" associationDirection="None" sourceRef="Node_create_bi_case" targetRef="Note_anno_bi_status" />
  </bpmn:process>
